package mail;

public class Persona {
	String nombre;
	String cargo;
	String cedula;
	public String getNombre() {
		return nombre;
	}
	public void setNombre(String nombre) {
		this.nombre = nombre;
	}
	public String getCargo() {
		return cargo;
	}
	public void setCargo(String cargo) {
		this.cargo = cargo;
	}
	public String getCedula() {
		return cedula;
	}
	public void setCedula(String cedula) {
		this.cedula = cedula;
	}
	public Persona(String nombre, String cargo, String cedula) {
		super();
		this.nombre = nombre;
		this.cargo = cargo;
		this.cedula = cedula;
	}
	

}
